  "probe_script": "import json,sys,hashlib\nfrom pathlib import Path\nimport bpy\nfrom mathutils import Vector\nroot=Path('/Users/brianwilliams/Desktop/Shoen-Rise-of-the-Samurai')\nsys.path.insert(0,str(root/'SourceArt/Characters/Samurai/Kusazuri01/Scripts'))\nimport review_kusazuri as r\nreview=r.Review()\nreport=json.loads((r.OUTPUT/'motion-validation.json').read_text())\nassert report['source_sha256']==review.source_hash\nassert report['motion_script_sha256']==review.motion_hash\nreview.scene.render.resolution_x=review.scene.render.resolution_y=900\nreview.scene.render.resolution_percentage=100\nreview.scene.render.image_settings.file_format='PNG'\nreview.scene.cycles.samples=16\nreview.visibility(True)\nfor pose,part,side in [('A_Run:31','Kusazuri_01_Front_L_Interior',1),('A_Run:40','Kusazuri_01_Front_R_Interior',-1),('knee-lift','Kusazuri_01_Front_L',1)]:\n    record=next(c for c in report['checks'] if c['pose']==pose)\n    review.apply(record)\n    contact=record['surface_intersections']['body'][part]\n    target=Vector(contact['deepest_sample']['point_metres'])\n    eye=target+Vector((side*1.25,-2.5,.40))\n    review.render('contact-close-'+pose.replace(':','-'),eye,target,.72,kind='body contact close view',pose=pose,measured_component=part,measured_contact=contact)\n    if pose=='knee-lift':\n        review.render('contact-close-knee-lift-side',target+Vector((2.7,-.50,.15)),target,.72,kind='body contact close view from left side',pose=pose,measured_component=part,measured_contact=contact)\nr.write_json(r.OUTPUT/'capture-contact-closeups.json',{'source_sha256':review.source_hash,'motion_script_sha256':review.motion_hash,'resolution':900,'cycles_samples':16,'captures':review.captures,'probe_script':Path(__file__).read_text(),'source_file_unchanged':r.sha256(review.source)==review.source_hash})\nprint('KUSAZURI_CONTACT_CLOSEUPS_COMPLETE',flush=True)\n",
